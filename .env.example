# Copy this file to .env and fill it in. Never commit .env.

# --- AI providers: set at least one key. Only providers with a key appear in the app. ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- BPS (Statistics Indonesia) WebAPI: optional. Adds the "BPS langsung" source, which fetches
# official figures without AI. Get a free key at https://webapi.bps.go.id/developer/ ---
BPS_API_KEY=

# Optional model overrides (defaults shown).
# GEMINI_MODEL_FAST=gemini-3-flash-preview
# GEMINI_MODEL_DEEP=gemini-3-pro-preview
# CLAUDE_MODEL=claude-opus-5-5

# --- Accounts and limits ---
# The first account that registers becomes the administrator (no daily limit).
# Set to false after your users have registered to close sign-up.
ALLOW_REGISTRATION=true
# Searches each user may run per 24 hours, and how many of those may be deep searches.
DAILY_SEARCH_LIMIT=20
DAILY_DEEP_LIMIT=5
# Questions each user may ask the research assistant per 24 hours.
DAILY_CHAT_LIMIT=50

# --- Local development only (npm run dev) ---
DATABASE_URL=postgres://datascout:datascout@localhost:5432/datascout

# --- Production with docker compose ---
# A long random password for the database, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=
# The address people will open, without https://
APP_DOMAIN=spss.example.com
# Settings of the Traefik already on the server (Hostinger template defaults shown).
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT=websecure
# Where Docker builds the image from. Leave unset to build from the current folder,
# or use a Git URL such as https://github.com/OWNER/REPO.git#main
# APP_BUILD_CONTEXT=.
# Set by the deploy workflow; leave empty to build the image on the server instead.
# APP_IMAGE=ghcr.io/OWNER/REPO:latest
# With APP_IMAGE set, also set APP_PULL_POLICY=always (default is build).
